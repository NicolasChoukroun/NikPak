<?xml version="1.0" encoding="UTF-8"?>
<!--
  NikPak web site - IIS configuration (replaces Apache .htaccess).
  Needs only modules that every IIS 7.5+ has (no URL Rewrite module required).
  Every link of the site points to a page file (en/index.html ...); the default document
  is only used for the bare address https://nikpak.nikkoid.com/ (index.php picks the language).
-->
<configuration>
  <system.webServer>

    <defaultDocument enabled="true">
      <files>
        <clear />
        <add value="index.php" />
        <add value="index.html" />
      </files>
    </defaultDocument>

    <directoryBrowse enabled="false" />

    <!-- .webp is unknown to IIS before version 10 (1803): without this, images return 404.3 -->
    <staticContent>
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
    </staticContent>

    <!-- Private files: helpers, settings, logs, the sample config, Apache leftovers -->
    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment="inc" />
        </hiddenSegments>
        <denyUrlSequences>
          <add sequence="/shop/lib.php" />
          <add sequence="shop-config" />
          <add sequence="site-public.json" />
          <add sequence=".htaccess" />
          <add sequence=".log" />
        </denyUrlSequences>
      </requestFiltering>
    </security>

    <httpProtocol>
      <customHeaders>
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
      </customHeaders>
    </httpProtocol>

  </system.webServer>

  <!-- Images, styles and scripts may be cached for a week; pages are always checked again -->
  <location path="assets">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="7.00:00:00" />
      </staticContent>
    </system.webServer>
  </location>
</configuration>
